{
  "name": "navoke",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-only",
  "description": "Navoke turns authenticated browser procedures into typed, resumable tools that return durable artifacts.",
  "homepage": "https://navoke.basedcode.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/BasedCodeDev/Navoke.git"
  },
  "main": "dist/main/main.js",
  "bin": {
    "navoke": "dist/cli/index.js"
  },
  "scripts": {
    "dev": "npm run build:main && concurrently -k -n renderer,electron -c cyan,green \"vite --host 127.0.0.1 --port 5173\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron dist/main/main.js\"",
    "build": "npm run build:main && npm run build:cli && npm run build:plugins && vite build",
    "build:main": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json",
    "build:cli": "tsc -p tsconfig.cli.json",
    "build:plugins": "node scripts/build-plugins.cjs",
    "start": "npm run build && electron dist/main/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.preload.json && tsc --noEmit -p tsconfig.cli.json && npm run typecheck:plugins",
    "typecheck:plugins": "node scripts/build-plugins.cjs --noEmit",
    "test": "npm run build:plugins && vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@google/model-viewer": "^4.2.0",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.90.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "extract-zip": "^2.0.1",
    "lucide-react": "^0.468.0",
    "playwright": "^1.56.1",
    "sql.js": "^1.13.0",
    "tailwind-merge": "^2.6.0",
    "three": "^0.182.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^41.5.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.5",
    "wait-on": "^8.0.1"
  }
}
