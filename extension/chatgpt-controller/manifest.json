{
  "manifest_version": 3,
  "name": "Browser Workflow Automation - ChatGPT Controller",
  "version": "0.4.0",
  "description": "Runs local Browser Workflow Automation tasks inside your normal ChatGPT tab.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1:*/*",
    "http://localhost:*/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Workflow Automation"
  }
}
